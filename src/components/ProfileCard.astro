---
import {
	AUTHOR_NAME,
	AUTHOR_TAGLINE,
	EMAIL_DOMAIN,
	EMAIL_USER,
	GITHUB_URL,
} from '../consts';
---

<aside class="profile-card">
	<div class="avatar-wrap">
		<img src="/avatar.png" alt={AUTHOR_NAME} width="72" height="72" loading="eager" />
	</div>
	<div class="profile-info">
		<h3 class="name">{AUTHOR_NAME}</h3>
		<p class="tagline">{AUTHOR_TAGLINE}</p>
		<div class="socials">
			<a
				class="pill"
				href={GITHUB_URL}
				target="_blank"
				rel="noopener"
				aria-label="GitHub"
			>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="13" height="13">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
				<span>GitHub</span>
			</a>
			<a
				class="pill"
				href="https://leisj24.github.io/career/"
				data-astro-reload
				aria-label="学术主页"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="13" height="13">
					<path
						fill="currentColor"
						d="M10 4h4a2 2 0 0 1 2 2v2h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2h3V6a2 2 0 0 1 2-2Zm4 4V6h-4v2h4Zm-6 2v2h2v-2H8Zm6 0v2h2v-2h-2Z"
					></path>
				</svg>
				<span>学术主页</span>
			</a>
			<a
				class="pill js-mail"
				href="#"
				data-u={EMAIL_USER}
				data-d={EMAIL_DOMAIN}
				aria-label="Email"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="13" height="13">
					<path
						fill="currentColor"
						d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"
					></path>
				</svg>
				<span>Email</span>
			</a>
		</div>
	</div>
</aside>

<style>
	.profile-card {
		padding: 1.1rem 1.1rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-card);
	}
	.avatar-wrap {
		display: inline-block;
		flex-shrink: 0;
		padding: 2px;
		background: linear-gradient(
			135deg,
			var(--color-accent),
			var(--color-accent-hover)
		);
		border-radius: var(--radius-pill);
	}
	.avatar-wrap img {
		display: block;
		width: 72px;
		height: 72px;
		border-radius: var(--radius-pill);
		object-fit: cover;
		background: var(--color-surface);
	}
	.profile-info {
		min-width: 0;
	}
	.name {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.tagline {
		margin: 0.3rem 0 0.7rem;
		color: var(--color-text-muted);
		font-size: 0.82rem;
		line-height: 1.55;
	}
	.socials {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.28rem 0.7rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		color: var(--color-text-muted);
		font-size: 0.78rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			border-color 200ms ease,
			color 200ms ease;
	}
	.pill:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	/* 桌面端：窄栏内垂直居中排布 */
	@media (min-width: 1024px) {
		.profile-card {
			text-align: center;
		}
		.avatar-wrap {
			margin-bottom: 0.7rem;
		}
		.socials {
			justify-content: center;
		}
	}

	/* 平板/移动端：横向紧凑布局，避免整块卡片堆叠在内容上方 */
	@media (max-width: 1023px) {
		.profile-card {
			display: flex;
			align-items: center;
			gap: 0.9rem;
		}
		.profile-info {
			flex: 1;
		}
		.tagline {
			margin-bottom: 0.55rem;
		}
		.socials {
			justify-content: flex-start;
		}
	}
</style>

<script is:inline>
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll('.js-mail').forEach((el) => {
			if (el.dataset.bound) return;
			el.dataset.bound = '1';
			el.addEventListener('click', (e) => {
				e.preventDefault();
				const u = el.dataset.u;
				const d = el.dataset.d;
				if (u && d) window.location.href = 'mailto:' + u + '@' + d;
			});
		});
	});
</script>
