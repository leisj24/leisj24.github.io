---
import { AUTHOR_NAME, GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="internal-links" id="primary-nav">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/resources">资料</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="actions">
			<a class="github" href={GITHUB_URL} target="_blank" rel="noopener" aria-label={`${AUTHOR_NAME} on GitHub`}>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			<ThemeToggle />
			<button
				class="nav-toggle"
				type="button"
				aria-label="打开菜单"
				aria-controls="primary-nav"
				aria-expanded="false"
			>
				<span class="bar"></span>
				<span class="bar"></span>
				<span class="bar"></span>
			</button>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--color-surface) 75%, transparent);
		backdrop-filter: saturate(180%) blur(12px);
		-webkit-backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid var(--color-border);
	}
	nav {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1080px;
		margin: 0 auto;
		padding: 0.65rem 1.25rem;
	}
	.brand {
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--color-text);
		text-decoration: none;
		transition: color 160ms ease;
	}
	.brand:hover {
		color: var(--color-accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.internal-links :global(a) {
		position: relative;
		padding: 0.5rem 0.9rem;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		font-weight: 500;
		border-radius: var(--radius-pill);
		transition: color 180ms ease, background 180ms ease;
	}
	.internal-links :global(a)::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: 0;
		width: 0;
		height: 3px;
		background: var(--color-accent);
		border-radius: var(--radius-pill);
		transform: translateX(-50%);
		transition: width 220ms ease;
	}
	.internal-links :global(a:hover) {
		color: var(--color-text);
	}
	.internal-links :global(a:hover)::after {
		width: 60%;
	}
	.internal-links :global(a.active) {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
	}
	.internal-links :global(a.active)::after {
		width: 60%;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.github {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		color: var(--color-text);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		transition:
			color 200ms ease,
			border-color 200ms ease;
	}
	.github:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}
	.nav-toggle {
		display: none;
		position: relative;
		width: 38px;
		height: 38px;
		align-items: center;
		justify-content: center;
		color: var(--color-text);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		cursor: pointer;
		transition:
			color 200ms ease,
			border-color 200ms ease;
	}
	.nav-toggle:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}
	.nav-toggle .bar {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 18px;
		height: 2px;
		margin-left: -9px;
		background: currentColor;
		border-radius: 2px;
		transition:
			transform 220ms ease,
			opacity 160ms ease;
	}
	.nav-toggle .bar:nth-child(1) {
		transform: translateY(-5px);
	}
	.nav-toggle .bar:nth-child(3) {
		transform: translateY(5px);
	}
	nav[data-open='true'] .nav-toggle .bar:nth-child(1) {
		transform: rotate(45deg);
	}
	nav[data-open='true'] .nav-toggle .bar:nth-child(2) {
		opacity: 0;
	}
	nav[data-open='true'] .nav-toggle .bar:nth-child(3) {
		transform: rotate(-45deg);
	}

	@media (max-width: 720px) {
		nav {
			padding: 0.5rem 0.75rem;
		}
		.brand {
			font-size: 0.95rem;
		}
		.github {
			display: none;
		}
		.nav-toggle {
			display: inline-flex;
		}
		.internal-links {
			position: absolute;
			top: calc(100% + 0.4rem);
			left: 0.75rem;
			right: 0.75rem;
			flex-direction: column;
			align-items: stretch;
			gap: 0.15rem;
			padding: 0.5rem;
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-card);
			box-shadow: var(--shadow-card-hover);
			opacity: 0;
			visibility: hidden;
			transform: translateY(-8px);
			transition:
				opacity 180ms ease,
				transform 180ms ease,
				visibility 180ms ease;
		}
		nav[data-open='true'] .internal-links {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}
		.internal-links :global(a) {
			padding: 0.65rem 0.8rem;
			font-size: 0.98rem;
			border-radius: var(--radius-sm);
		}
		.internal-links :global(a)::after {
			display: none;
		}
		.internal-links :global(a:hover),
		.internal-links :global(a.active) {
			background: color-mix(in srgb, var(--color-accent-soft) 25%, transparent);
		}
	}
</style>

<script is:inline>
	document.addEventListener('astro:page-load', () => {
		const nav = document.querySelector('header nav');
		const btn = nav && nav.querySelector('.nav-toggle');
		if (nav && btn && !btn.dataset.bound) {
			btn.dataset.bound = '1';
			const setOpen = (open) => {
				nav.dataset.open = open ? 'true' : 'false';
				btn.setAttribute('aria-expanded', open ? 'true' : 'false');
				btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
			};
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				setOpen(nav.dataset.open !== 'true');
			});
			nav.querySelectorAll('.internal-links a').forEach((a) =>
				a.addEventListener('click', () => setOpen(false)),
			);
		}

		if (!document.documentElement.dataset.navGlobal) {
			document.documentElement.dataset.navGlobal = '1';
			const closeNav = () => {
				const n = document.querySelector('header nav');
				if (!n || n.dataset.open !== 'true') return null;
				n.dataset.open = 'false';
				const b = n.querySelector('.nav-toggle');
				if (b) {
					b.setAttribute('aria-expanded', 'false');
					b.setAttribute('aria-label', '打开菜单');
				}
				return b;
			};
			document.addEventListener('click', (e) => {
				const n = document.querySelector('header nav');
				if (n && n.dataset.open === 'true' && !n.contains(e.target)) closeNav();
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					const b = closeNav();
					if (b) b.focus();
				}
			});
			window.addEventListener('resize', () => {
				if (window.innerWidth > 720) {
					const n = document.querySelector('header nav');
					if (n) n.dataset.open = 'false';
				}
			});
		}
	});
</script>
